# All payments are simulated. No payment credentials are accepted by this app.
# Set the canonical HTTPS production origin before building for deployment.
# Used by public SEO metadata, sitemap.xml and llms.txt. Local previews default to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAMOJA_DATA_DIR=.data
# Set a stable random secret of at least 32 characters for persistent QR signatures.
# When omitted, an automatically generated secret is stored in the local SQLite database.
PAMOJA_QR_SECRET=
# Optional existing ASP.NET SignalR hub. The app polls every 10s without a hub.
NEXT_PUBLIC_SIGNALR_URL=
