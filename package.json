{
  "name": "pamoja",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/version-service-worker.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain.test.ts tests/store.test.ts",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.2.0",
    "@fontsource-variable/schibsted-grotesk": "^5.2.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@microsoft/signalr": "^10.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@squircle-js/react": "^1.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "next": "16.4.2",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0"
}
