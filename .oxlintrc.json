{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "jsx-a11y"],
  "categories": { "correctness": "error" },
  "rules": { "no-unused-vars": "error", "react/react-in-jsx-scope": "off" },
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "next-env.d.ts",
    "playwright-report/**",
    "test-results/**"
  ]
}
